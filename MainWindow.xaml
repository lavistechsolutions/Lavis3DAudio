<Window x:Class="Lavis3DAudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lavis 3D Audio" Width="1200" Height="800" MinWidth="1060" MinHeight="720"
        Icon="Assets/app.ico" WindowStartupLocation="CenterScreen" AllowDrop="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="ThumbPrev" Description="Previous" ImageSource="{StaticResource ThumbPrevImage}"/>
                <ThumbButtonInfo x:Name="ThumbPlay" Description="Play" ImageSource="{StaticResource ThumbPlayImage}"/>
                <ThumbButtonInfo x:Name="ThumbNext" Description="Next" ImageSource="{StaticResource ThumbNextImage}"/>
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- Shared by the loop popup and the settings panel -->
        <DataTemplate x:Key="LoopOptions">
            <StackPanel>
                <TextBlock Text="Repeat" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                <Border Background="{StaticResource ControlBrush}" CornerRadius="19" Padding="4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Play once" Style="{StaticResource Segment}"
                                     IsChecked="{Binding LoopMode, Converter={StaticResource Is}, ConverterParameter=Once}"/>
                        <RadioButton Content="Repeat x times" Style="{StaticResource Segment}"
                                     IsChecked="{Binding LoopMode, Converter={StaticResource Is}, ConverterParameter=Times}"/>
                        <RadioButton Content="Endless" Style="{StaticResource Segment}"
                                     IsChecked="{Binding LoopMode, Converter={StaticResource Is}, ConverterParameter=Endless}"/>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                            IsEnabled="{Binding LoopMode, Converter={StaticResource Is}, ConverterParameter=Times}">
                    <TextBlock Text="Play" VerticalAlignment="Center" Width="44"/>
                    <Button Content="−" Style="{StaticResource PillButton}" Padding="12,3" Click="LoopLess_Click"/>
                    <TextBlock Text="{Binding LoopTimes}" FontSize="16" FontWeight="SemiBold" Width="40"
                               TextAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="+" Style="{StaticResource PillButton}" Padding="12,3" Click="LoopMore_Click"/>
                    <TextBlock Text="times" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Applies to" Style="{StaticResource Muted}" Margin="0,14,0,6"/>
                <Border Background="{StaticResource ControlBrush}" CornerRadius="19" Padding="4" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="Current track" Style="{StaticResource Segment}"
                                     IsChecked="{Binding LoopScope, Converter={StaticResource Is}, ConverterParameter=Track}"/>
                        <RadioButton Content="Whole playlist" Style="{StaticResource Segment}"
                                     IsChecked="{Binding LoopScope, Converter={StaticResource Is}, ConverterParameter=Playlist}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Ambient glow -->
        <Canvas Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="760" Height="760" Canvas.Left="-260" Canvas.Top="-320">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3300E5FF" Offset="0"/>
                        <GradientStop Color="#0000E5FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="900" Height="900" Canvas.Left="640" Canvas.Top="260">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#33B04BFF" Offset="0"/>
                        <GradientStop Color="#00B04BFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Canvas>

        <!-- Title bar -->
        <Grid Margin="20,0,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="Assets/app.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="LAVIS 3D AUDIO" FontSize="17" FontWeight="Bold"/>
                    <TextBlock Text="Surround Sound Engine" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource ControlBrush}"
                    CornerRadius="19" Padding="4" WindowChrome.IsHitTestVisibleInChrome="True">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Music Player" Style="{StaticResource Segment}"
                                 IsChecked="{Binding SourceMode, Converter={StaticResource Is}, ConverterParameter=Player}"/>
                    <RadioButton Content="Live Input" Style="{StaticResource Segment}"
                                 IsChecked="{Binding SourceMode, Converter={StaticResource Is}, ConverterParameter=Live}"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="AboutButton" Content="&#xE946;" FontSize="14" ToolTip="About" Style="{StaticResource CaptionButton}"/>
                <Button x:Name="SettingsButton" Content="&#xE713;" FontSize="14" ToolTip="Settings" Style="{StaticResource CaptionButton}"/>
                <Button x:Name="MinButton" Content="&#xE921;" Style="{StaticResource CaptionButton}"/>
                <Button x:Name="MaxButton" Content="&#xE922;" Style="{StaticResource CaptionButton}"/>
                <Button x:Name="CloseButton" Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}"/>
            </StackPanel>
        </Grid>

        <!-- Main area -->
        <Grid Grid.Row="1" Margin="16,4,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- 3D Surround -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="3D SURROUND" Style="{StaticResource Header}"/>
                    <ToggleButton Style="{StaticResource Toggle3D}" IsChecked="{Binding SurroundEnabled}"
                                  HorizontalAlignment="Center" Margin="0,12,0,14"/>

                    <Border HorizontalAlignment="Center" Background="{StaticResource ControlBrush}" CornerRadius="19" Padding="4" Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Headphones" Style="{StaticResource Segment}" IsChecked="{Binding HeadphoneMode}"/>
                            <RadioButton Content="Speakers" Style="{StaticResource Segment}" IsChecked="{Binding SpeakerMode}"/>
                        </StackPanel>
                    </Border>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Intensity, StringFormat={}{0:0}%}"/>
                        <TextBlock Text="Intensity" FontSize="13"/>
                    </DockPanel>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="0" Maximum="100" Value="{Binding Intensity}" Margin="0,4,0,12"/>

                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Text="{Binding Ambience, StringFormat={}{0:0}%}"/>
                        <TextBlock Text="Ambience" FontSize="13"/>
                    </DockPanel>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="0" Maximum="100" Value="{Binding Ambience}" Margin="0,4,0,12"/>

                    <DockPanel>
                        <TextBlock x:Name="OrbitValue" DockPanel.Dock="Right" Style="{StaticResource Muted}"/>
                        <TextBlock Text="3D Orbit" FontSize="13"/>
                    </DockPanel>
                    <Slider Style="{StaticResource NeonSlider}" Minimum="0" Maximum="1" Value="{Binding Orbit}" Margin="0,4,0,0"/>
                    <TextBlock Text="Moves the sound around your head." Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Center: now playing + playlist/live -->
            <Grid Grid.Column="1" Margin="8,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="200"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="NOW PLAYING" Style="{StaticResource Header}"/>
                            <TextBlock x:Name="TrackTitle" Text="Drop music here or click Open" FontSize="22" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TrackInfo" Text="MP3, WAV, FLAC, M4A, AAC, WMA, AIFF" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Canvas x:Name="Spectrum" Grid.Row="1" Margin="0,14" ClipToBounds="True"/>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="48"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TimeText" Text="0:00" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Slider x:Name="Seek" Grid.Column="1" Style="{StaticResource NeonSlider}" Minimum="0" Maximum="1"/>
                            <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Style="{StaticResource Muted}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>

                        <StackPanel x:Name="Transport" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button x:Name="StopButton" Style="{StaticResource IconButton}" ToolTip="Stop">
                                <Rectangle Width="13" Height="13" RadiusX="2" RadiusY="2" Fill="{StaticResource TextBrush}"/>
                            </Button>
                            <Button x:Name="PrevButton" Style="{StaticResource IconButton}" Margin="8,0" ToolTip="Previous">
                                <Path Data="M0,0 H3 V16 H0Z M16,0 V16 L4,8Z" Fill="{StaticResource TextBrush}"/>
                            </Button>
                            <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" ToolTip="Play / Pause (Space)">
                                <Path x:Name="PlayIcon" Data="M0,0 L0,22 18,11Z" Fill="#0A0E18" Margin="4,0,0,0"/>
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource IconButton}" Margin="8,0" ToolTip="Next">
                                <Path Data="M0,0 L12,8 0,16Z M13,0 H16 V16 H13Z" Fill="{StaticResource TextBrush}"/>
                            </Button>
                            <Button x:Name="LoopButton" Style="{StaticResource IconButton}" Width="56">
                                <Grid>
                                    <Path x:Name="LoopIcon" Width="20" Height="16" Stretch="Uniform" StrokeThickness="1.8"
                                          Stroke="{StaticResource TextBrush}" StrokeLineJoin="Round"
                                          Data="M3,9 V6 A3,3 0 0 1 6,3 H17 M14,0 L17,3 14,6 M17,9 V12 A3,3 0 0 1 14,15 H3 M6,12 L3,15 6,18"/>
                                    <TextBlock x:Name="LoopBadge" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentSolidBrush}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-8,-14,0"/>
                                </Grid>
                            </Button>
                            <Button x:Name="OpenButton" Style="{StaticResource IconButton}" ToolTip="Open files">
                                <Path Data="M0,4 H6 L8,6 H16 V16 H0Z" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"/>
                            </Button>
                        </StackPanel>

                        <Popup x:Name="LoopPopup" PlacementTarget="{Binding ElementName=LoopButton}" Placement="Top"
                               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-8">
                            <Border Background="#F2161C2E" BorderBrush="{StaticResource ControlBorderBrush}" BorderThickness="1"
                                    CornerRadius="14" Padding="16">
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LoopOptions}"
                                                Foreground="{StaticResource TextBrush}"/>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="18,14">
                    <Grid>
                        <DockPanel x:Name="PlayerPanel">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button x:Name="AddButton" Content="Add files" Style="{StaticResource PillButton}" Padding="12,4"/>
                                    <Button x:Name="ClearButton" Content="Clear" Style="{StaticResource PillButton}" Padding="12,4" Margin="6,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="PLAYLIST" Style="{StaticResource Header}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ListBox x:Name="Playlist" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource TrackItemStyle}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Format}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>

                        <StackPanel x:Name="LivePanel" Visibility="Collapsed">
                            <TextBlock Text="LIVE INPUT" Style="{StaticResource Header}"/>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="LiveInput" Style="{StaticResource DarkCombo}"
                                          SelectedValuePath="Key" SelectedValue="{Binding InputSourceKey}"/>
                                <Button x:Name="RefreshSourcesButton" Grid.Column="1" Content="Refresh" Style="{StaticResource PillButton}" Margin="8,0,0,0"/>
                                <Button x:Name="LiveButton" Grid.Column="2" Content="Start" Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="80"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0" FontSize="11.5">
                                Everything in 3D: choose "All PC sound (system-wide)", pick your speakers under Output device and press Start.
                                Like FxSound, every app is routed through the app; your normal output comes back when you stop.
                            </TextBlock>
                            <Button x:Name="OpenMixerButton" Content="Open Windows Volume mixer" Style="{StaticResource PillButton}"
                                    HorizontalAlignment="Left" Margin="0,10,0,0" Padding="12,4"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Volume booster -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Margin="8,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="VOLUME BOOSTER" Style="{StaticResource Header}"/>

                    <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Boost, StringFormat={}{0:0}%}" FontSize="40" FontWeight="Black" Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock x:Name="BoostDb" Text="+0.0 dB gain" Style="{StaticResource Muted}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse x:Name="LimiterDot" Width="8" Height="8" Fill="#FF3D71" Opacity="0.25" VerticalAlignment="Center"/>
                            <TextBlock Text="Smart limiter (no clipping)" Style="{StaticResource Muted}" FontSize="11.5" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Output device" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                        <ComboBox x:Name="OutputDevice" Style="{StaticResource DarkCombo}"
                                  SelectedValuePath="Id" SelectedValue="{Binding OutputDeviceId}"/>
                    </StackPanel>

                    <Grid Margin="0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Slider Style="{StaticResource NeonSliderV}" Minimum="100" Maximum="400" Value="{Binding Boost}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Text="Boost" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>

                        <Slider Grid.Column="1" Style="{StaticResource NeonSliderV}" Minimum="0" Maximum="100" Value="{Binding Volume}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Volume, StringFormat={}{0:0}}" Style="{StaticResource Muted}"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Width="8" CornerRadius="4" Background="{StaticResource TrackBrush}" ClipToBounds="True">
                                <Border CornerRadius="4" Background="{StaticResource MeterBrush}" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="MeterLScale" ScaleY="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <Border Width="8" CornerRadius="4" Background="{StaticResource TrackBrush}" ClipToBounds="True" Margin="5,0,0,0">
                                <Border CornerRadius="4" Background="{StaticResource MeterBrush}" RenderTransformOrigin="0.5,1">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="MeterRScale" ScaleY="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Grid.Row="1" Text="L  R" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Equalizer -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="16,8,16,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding EqEnabled}"/>
                        <TextBlock Text="EQUALIZER" Style="{StaticResource Header}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <TextBlock Text="Preset" Style="{StaticResource Muted}" Margin="0,16,0,6"/>
                    <ComboBox x:Name="EqPreset" Style="{StaticResource DarkCombo}" SelectedItem="{Binding EqPreset}"/>
                    <Button x:Name="EqReset" Content="Reset" Style="{StaticResource PillButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="16,5"/>
                </StackPanel>
                <UniformGrid x:Name="EqBands" Grid.Column="1" Rows="1" Height="160" Margin="24,0,0,0"/>
            </Grid>
        </Border>

        <!-- Settings -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#B3050810">
            <Border Style="{StaticResource Card}" Width="640" Margin="0,64,0,24" HorizontalAlignment="Center"
                    Background="#F7121828" Padding="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="26,18,14,6">
                        <Button x:Name="CloseSettingsButton" DockPanel.Dock="Right" Content="&#xE8BB;" Style="{StaticResource CaptionButton}"
                                Width="40" Height="36" VerticalAlignment="Center"/>
                        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,0,26,24">
                        <StackPanel>
                            <TextBlock Text="SOUND OUTPUT" Style="{StaticResource Header}" Margin="0,12,0,10"/>
                            <DockPanel Margin="0,0,0,10">
                                <ComboBox x:Name="SettingsOutput" DockPanel.Dock="Right" Width="320" Style="{StaticResource DarkCombo}"
                                          SelectedValuePath="Id" SelectedValue="{Binding OutputDeviceId}"/>
                                <TextBlock Text="Output device" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource ControlBrush}" CornerRadius="19" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Headphones" Style="{StaticResource Segment}" IsChecked="{Binding HeadphoneMode}"/>
                                        <RadioButton Content="Speakers" Style="{StaticResource Segment}" IsChecked="{Binding SpeakerMode}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Listening on" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="LIVE INPUT SOURCE" Style="{StaticResource Header}" Margin="0,24,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SettingsInput" Style="{StaticResource DarkCombo}"
                                          SelectedValuePath="Key" SelectedValue="{Binding InputSourceKey}"/>
                                <Button x:Name="SettingsRefreshButton" Grid.Column="1" Content="Refresh" Style="{StaticResource PillButton}" Margin="8,0,0,0"/>
                            </Grid>
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="11.5">
                                "All PC sound" routes every app through Lavis via the FxSound Speakers device (FxSound itself must be closed).
                                "App:" captures one program (e.g. your browser for YouTube). "Input:" is a microphone, line-in or virtual cable.
                                "System audio:" captures everything played on that device.
                            </TextBlock>

                            <TextBlock Text="PLAYER LOOP" Style="{StaticResource Header}" Margin="0,24,0,10"/>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LoopOptions}"/>

                            <TextBlock Text="STARTUP &amp; SAVING" Style="{StaticResource Header}" Margin="0,24,0,10"/>
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding RememberSoundSettings}"/>
                                <TextBlock Text="Remember volume, 3D and equalizer settings" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding SavePlaylist}"/>
                                <TextBlock Text="Save playlist" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding ResumeLastTrack}"/>
                                <TextBlock Text="Reopen last track where I left off" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,10">
                                <CheckBox DockPanel.Dock="Right" Style="{StaticResource Switch}" IsChecked="{Binding AutoStartLive}"/>
                                <TextBlock Text="Start live input automatically when opening in Live mode" VerticalAlignment="Center"/>
                            </DockPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource ControlBrush}" CornerRadius="19" Padding="4">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Last used" Style="{StaticResource Segment}"
                                                     IsChecked="{Binding StartIn, Converter={StaticResource Is}, ConverterParameter=LastUsed}"/>
                                        <RadioButton Content="Music Player" Style="{StaticResource Segment}"
                                                     IsChecked="{Binding StartIn, Converter={StaticResource Is}, ConverterParameter=Player}"/>
                                        <RadioButton Content="Live Input" Style="{StaticResource Segment}"
                                                     IsChecked="{Binding StartIn, Converter={StaticResource Is}, ConverterParameter=Live}"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Open in" VerticalAlignment="Center"/>
                            </DockPanel>

                            <TextBlock Text="RESET" Style="{StaticResource Header}" Margin="0,24,0,10"/>
                            <WrapPanel>
                                <Button x:Name="ResetSoundButton" Content="Reset sound settings" Style="{StaticResource PillButton}" Margin="0,0,8,8"/>
                                <Button x:Name="ResetAllButton" Content="Reset all settings" Style="{StaticResource PillButton}" Margin="0,0,8,8"/>
                                <Button x:Name="OpenSettingsFolderButton" Content="Open settings folder" Style="{StaticResource PillButton}" Margin="0,0,8,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
