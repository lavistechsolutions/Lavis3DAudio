<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lavis3DAudio</RootNamespace>
    <AssemblyName>Lavis3DAudio</AssemblyName>
    <Product>Lavis 3D Audio</Product>
    <AssemblyTitle>Lavis 3D Audio</AssemblyTitle>
    <Description>Lavis 3D Audio - 3D Surround Sound and Volume Booster</Description>
    <Version>1.0.0.51</Version>
    <AssemblyVersion>1.0.0.51</AssemblyVersion>
    <FileVersion>1.0.0.51</FileVersion>
    <Company>Lavistech Solutions</Company>
    <Copyright>Copyright © Lavistech Solutions</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Steam Audio 4.8.1 (Apache-2.0), https://github.com/ValveSoftware/steam-audio -->
    <None Include="native\win-x64\phonon.dll" Link="phonon.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="docs\SteamAudio-Apache-2.0.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="docs\NAudio-MIT.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="docs\SteamAudio-Apache-2.0.pdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="docs\NAudio-MIT.pdf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
